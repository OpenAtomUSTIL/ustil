/storage/
/uploads/
/postgres-data/
/redis-data/
/ustil-hub/storage/
/ustil-hub/uploads/
/ustil-hub/postgres-data/
/ustil-hub/redis-data/
/deploy/storage/
/deploy/uploads/
/deploy/postgres-data/
/deploy/redis-data/
/deploy/pg-data/
/deploy/uploads-data/
/deploy/backups/
/backups/
# Redis 本地快照和持久化文件；数据库迁移 *.sql 正常提交。
dump.rdb
appendonly.aof
appendonlydir/

