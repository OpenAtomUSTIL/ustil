# ============================================================
# USTIL 部署环境变量模板
# 用法：cp .env.example .env 并逐项填真实值
# 红线：.env 已被 .gitignore 忽略，MUST NOT 提交进仓库；本文件只放占位
# 说明：DATABASE_URL / REDIS_URL 由 docker-compose.yml 用 POSTGRES_* 拼接注入，无需在此填写
# 说明：密码/密钥避免 @ : / # 等 URL 特殊字符，否则需先 URL 编码（会拼进 DATABASE_URL）
# ============================================================

# ===== PostgreSQL =====
POSTGRES_DB=ustil
POSTGRES_USER=ustil
POSTGRES_PASSWORD=change-me

# ===== JWT 双 token 密钥（后端校验最少 16 字符；务必替换为高强度随机串）=====
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# ===== 对象存储（AGENTS.md §12：STORAGE_DRIVER=local | r2）=====
STORAGE_DRIVER=local
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# ===== 上传 =====
# 单文件上限（字节），默认 10MB；nginx client_max_body_size 12m 留余量
UPLOAD_MAX_SIZE=10485760

# ===== 反代（当前链路：浏览器 → web/nginx → api）=====
# api 不对外映射端口，nginx 覆盖转发头；支持 0（直连）或 1（单层反代）
TRUST_PROXY_HOPS=1

# ===== CORS =====
# 生产为同源（nginx 反代），按需收紧为站点域名
CORS_ORIGIN=http://localhost

# ===== 初始 ADMIN 种子（docker compose --profile seed run --rm seed，幂等）=====
# 真实密码只写进 .env（已 gitignore），MUST NOT 提交；公共账号建议上线后轮换密码
ADMIN_EMAIL=admin@ustil.com
ADMIN_PASSWORD=change-me

# ===== 前端构建（Vite，构建期注入）=====
# 同源反代（nginx location /api/ → api:3000）时留空即可
VITE_API_BASE_URL=
