# ============================================================
# USTIL 部署环境变量模板
# 用法：cp .env.example .env 并逐项填真实值
# 红线：.env 已被 .gitignore 忽略，MUST NOT 提交进仓库；本文件只放占位
# 说明：DATABASE_URL / REDIS_URL 由 docker-compose.yml 用 POSTGRES_* 拼接注入，无需在此填写
# 说明：密码/密钥避免 @ : / # 等 URL 特殊字符，否则需先 URL 编码（会拼进 DATABASE_URL）
# ============================================================

# ===== PostgreSQL =====
POSTGRES_DB=ustil
POSTGRES_USER=ustil
POSTGRES_PASSWORD=change-me

# ===== JWT 双 token 密钥（后端校验最少 16 字符；务必替换为高强度随机串）=====
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# ===== 个人信息信封加密主密钥（v10.0，必填——缺它 api 启动即拒）=====
# 32 字节 base64，生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 丢钥 = 存量个人数据永久不可解；换钥须走 AGENTS.md §11.5「先解密再重封」（backfill 任务）
APP_ENCRYPTION_KEY=change-me

# ===== 对象存储（AGENTS.md §12：STORAGE_DRIVER=local | r2）=====
STORAGE_DRIVER=local
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# ===== 上传 =====
# 单文件上限（字节），默认 10MB；nginx client_max_body_size 12m 留余量
UPLOAD_MAX_SIZE=10485760

# ===== 反代（当前链路：浏览器 → web/nginx → api）=====
# api 不对外映射端口，nginx 覆盖转发头；支持 0（直连）或 1（单层反代）
TRUST_PROXY_HOPS=1

# ===== CORS =====
# 逗号分隔多源（携带凭证）；文档站试调需含 docs 子域
CORS_ORIGIN=https://forum.openatomustil.cn,https://docs.openatomustil.cn

# ===== cookie 域（v11.0，可选）=====
# .openatomustil.cn —— 主站会话对 docs 子域可见（文档站试调用）；单域部署可留空
COOKIE_DOMAIN=

# ===== 初始 ADMIN 种子（docker compose --profile seed run --rm seed，幂等）=====
# 真实密码只写进 .env（已 gitignore），MUST NOT 提交；公共账号建议上线后轮换密码
ADMIN_EMAIL=admin@ustil.com
ADMIN_PASSWORD=change-me

# ===== 前端构建（Vite，构建期注入）=====
# 同源反代（nginx location /api/ → api:3000）时留空即可
VITE_API_BASE_URL=

# ===== 事务邮件（v12.0，腾讯云邮件推送 SES）=====
# api（SendEmail 模板发送，生产推荐）| smtp（SMTP 中继）| none（不发信）
MAIL_DRIVER=api
# 发件人地址：须为已验证发信域名下的地址；可带别名：USTIL 开放论坛 <noreply@mail.你的域名>
MAIL_FROM=ustil@notice.openatomustil.cn
# 邮件链接固定域名（腾讯模板审核规范：域名固定、变量只承载路径段）
MAIL_LINK_BASE=https://forum.openatomustil.cn
# 腾讯云 SES 控制台模板 ID（api 驱动必填；已过审模板）
MAIL_TPL_VERIFY_ID=236752
MAIL_TPL_RESET_ID=236751
MAIL_TPL_NOTICE_REPLY_ID=236754
MAIL_TPL_NOTICE_ID=236755
# api 驱动：腾讯云 API 密钥（建议受限子账号，只授 SES 发信权限；只写进 .env，MUST NOT 提交）
MAIL_API_SECRET_ID=
MAIL_API_SECRET_KEY=
MAIL_API_REGION=ap-hongkong
# smtp 驱动（可选）：腾讯云 SES SMTP 接口，密码为控制台生成的 SMTP 专用密码
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
